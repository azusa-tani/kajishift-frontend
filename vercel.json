{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "**",
      "use": "@vercel/static"
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "kajishift-frontend.vercel.app"
        }
      ],
      "destination": "https://kajishift.com/admin",
      "permanent": false
    },
    {
      "source": "/admin/",
      "has": [
        {
          "type": "host",
          "value": "kajishift-frontend.vercel.app"
        }
      ],
      "destination": "https://kajishift.com/admin/",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "has": [
        {
          "type": "host",
          "value": "kajishift-frontend.vercel.app"
        }
      ],
      "destination": "https://kajishift.com/admin/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}